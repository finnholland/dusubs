rules_version = '2';

// DuSubs sync model — no password/OAuth backend, "no real auth just a token".
//
// Two independent namespaces live under /users/{id}:
//
// 1. users/{uid}/**       — uid is a real Firebase Anonymous Auth uid.
//                           Gated normally by request.auth.uid. Used only to
//                           remember which sync token this browser session
//                           currently owns (users/{uid}/meta/token).
//
// 2. users/{uuid}/**      — uuid is a short random id (e.g. "a1b2c3")
//                           generated by the extension's Generate button.
//                           This is the *capability*: anyone holding the
//                           exact uuid gets full read/write to that
//                           account's words, the same trust model as an
//                           unguessable share link (no request.auth check is
//                           possible or intended here, since the browser
//                           extension has no Firebase auth session at all —
//                           it calls the REST API directly with the uuid as
//                           a path segment).
//
//                           users/{uuid}/meta/account also holds:
//                             - `username` — a unique, renameable
//                               identifier (e.g. "jonsmith"). Checked for
//                               uniqueness before Generate/rename via a
//                               collection-group query over every meta doc
//                               (see the collection-group match below).
//                             - `passphrase` — the real second factor
//                               (e.g. "quiet-tiger"), NOT unique/looked-up.
//                           The string a user actually copies/pastes is
//                           "username-passphrase" joined together; clients
//                           resolve the username to its account via the
//                           collection-group query, then require the stored
//                           passphrase to match before treating a pasted
//                           code as valid, so a guessed passphrase alone can
//                           never confirm whether some username exists (the
//                           query only returns username matches, and a
//                           passphrase mismatch on a real match fails
//                           identically to a nonexistent username).
//                           Renaming updates meta/account.username or
//                           .passphrase in place and never touches uuid or
//                           moves any word data.
//
// Because both namespaces share the same /users/{id} collection, rules can't
// tell which "kind" of id a given request is using — a real uid is
// unguessable in the same way a capability uuid is, so allowing open access
// to /users/{id}/** uniformly is intentional and does not weaken the
// uid-based docs beyond "you must already know a specific anonymous uid to
// touch it", which is equivalent to the uuid model.
//
// Users should be told (and are, in Settings/the extension popup) to treat
// their full sync token like a password: anyone who has it can read/delete
// their saved words.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{id}/{document=**} {
      allow read, write: if true;
    }

    // Collection-group read of every users/*/meta/* doc, needed so a pasted
    // "username-passphrase" token can be resolved to its uuid via a
    // `where username == ...` query without already knowing the uuid (see
    // resolveToken in extension/src/sync.js and web/lib/auth.ts). The
    // `users/{id}/{document=**}` match above does NOT cover collection-group
    // queries — Firestore requires a separate rule scoped to the group.
    // Read-only: writes to meta/account still go through the path-scoped
    // rule above.
    match /{path=**}/meta/{doc} {
      allow read: if true;
    }
  }
}
